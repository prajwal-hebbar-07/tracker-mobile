{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Logbook Widget",
  "version": "1.0.0",
  "identifier": "works.oni.logbook.widget",
  "build": {
    "beforeDevCommand": "npm run web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "widget",
        "title": "Logbook",
        "width": 340,
        "height": 460,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnBottom": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "acceptFirstMouse": true,
        "windowEffects": {
          "effects": ["liquidGlassRegular", "hudWindow"],
          "state": "active",
          "radius": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Attendance and leave log on your desktop",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "14.4"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDQUM4QzhGRDY0M0E1MjAKUldRZ3BVUFdqNHlzL0Rzek0wVHBrQzA2OXNsQ1VTNkY4SGpBN2oxcWFTRGdoczYrZjhUVUJxa2UK",
      "endpoints": ["https://github.com/prajwal-hebbar-07/tracker-mobile/releases/download/widget-updates/latest.json"]
    }
  }
}
