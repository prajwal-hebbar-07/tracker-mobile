<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- WidgetKit only loads sandboxed extensions. The exception lets the widget read the log the app and the CLI
     share (src/main.rs), and nothing else. Temporary exceptions are fine outside the Mac App Store. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/works.oni.logbook.widget/</string>
	</array>
</dict>
</plist>
